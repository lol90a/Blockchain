{
  "name": "iot-device-registry",
  "version": "1.0.0",
  "description": "IoT Device Registry with Hyperledger Fabric",
  "main": "api/server.js",
  "scripts": {
    "start": "node api/server.js",
    "dev": "nodemon api/server.js",
    "test": "node scripts/test-all-operations.js",
    "test:mock": "FABRIC_MOCK_MODE=true node scripts/test-all-operations.js",
    "deploy:fabric": "./scripts/deploy-fabric.sh",
    "package": "docker run --rm -v $(pwd):/workspace hyperledger/fabric-peer:2.5 peer lifecycle chaincode package /workspace/deviceContract.tar.gz --path /workspace/chaincode/deviceContract --lang node --label deviceContract_1"
  },
  "keywords": [
    "iot",
    "hyperledger",
    "fabric",
    "blockchain",
    "device-registry"
  ],
  "author": "Your Name",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "fabric-ca-client": "^2.2.19",
    "fabric-network": "^2.2.19",
    "jsonwebtoken": "^9.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
